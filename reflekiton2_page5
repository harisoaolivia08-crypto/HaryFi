<!DOCTYPE html>
<html lang="de">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>HaryFi – Lektion 2: Reflektion</title>

    <script src="https://cdn.tailwindcss.com"></script>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            min-height: 100vh;
            font-family: Arial, sans-serif;
            color: #17120d;

            background: linear-gradient(
                -45deg,
                #ff4500,
                #ff7e00,
                #ffd000,
                #00c9ff,
                #7c3aed,
                #ff3cac
            );

            background-size: 500% 500%;
            animation: gradientMove 18s ease infinite;
        }

        @keyframes gradientMove {
            0% {
                background-position: 0% 50%;
            }

            25% {
                background-position: 100% 50%;
            }

            50% {
                background-position: 100% 100%;
            }

            75% {
                background-position: 0% 100%;
            }

            100% {
                background-position: 0% 50%;
            }
        }

        .glass {
            background: rgba(255,255,255,.22);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid rgba(255,255,255,.45);
        }

        .reflection-card {
            background: rgba(255,255,255,.92);
            border-radius: 28px;
            padding: 25px;
            box-shadow: 0 15px 35px rgba(0,0,0,.15);
        }

        .question-card {
            background: rgba(255,255,255,.85);
            border-radius: 20px;
            padding: 20px;
            margin-bottom: 15px;
            box-shadow: 0 8px 20px rgba(0,0,0,.08);
        }

        textarea {
            width: 100%;
            min-height: 90px;
            margin-top: 12px;
            padding: 14px;
            border: 2px solid rgba(0,0,0,.12);
            border-radius: 15px;
            resize: vertical;
            font-family: Arial, sans-serif;
            font-size: 16px;
            outline: none;
        }

        textarea:focus {
            border-color: #111;
        }

        .save-button,
        .back-button {
            transition: .2s ease;
        }

        .save-button:hover,
        .back-button:hover {
            transform: translateY(-4px) scale(1.03);
        }

        .save-button:active,
        .back-button:active {
            transform: scale(.96);
        }
    </style>
</head>


<body>


<header class="px-5 py-5">

    <div class="max-w-7xl mx-auto flex items-center justify-between gap-4">

        <a
            href="lektion2.html"
            class="glass rounded-2xl px-5 py-3 font-black text-lg"
        >
            ← Lektion 2
        </a>

        <div class="glass rounded-full px-5 py-2 font-bold text-sm">
            🇩🇪 Deutschkurs
        </div>

    </div>

</header>



<main class="max-w-4xl mx-auto px-5 pb-20">


    <!-- TITRE -->

    <section class="text-center pt-8 pb-10">

        <div
            class="
                inline-block
                glass
                rounded-full
                px-5
                py-2
                mb-5
                text-xs
                font-black
                uppercase
                tracking-widest
            "
        >
            Lektion 2 · Seite 5
        </div>

        <h1 class="text-5xl md:text-7xl font-black tracking-tight mb-5">
            Reflektion
        </h1>

        <p class="text-lg md:text-xl font-semibold">
            Denke über deine Lernerfolge in Lektion 2 nach.
        </p>

    </section>



    <!-- REFLEKTION -->

    <section class="reflection-card">

        <div class="text-center mb-8">

            <div class="text-5xl mb-4">
                🧠
            </div>

            <h2 class="text-3xl md:text-4xl font-black">
                Meine Reflektion
            </h2>

            <p class="mt-3 font-semibold opacity-70">
                Schreibe deine Antworten auf.
            </p>

        </div>



        <!-- FRAGE 1 -->

        <div class="question-card">

            <h3 class="text-xl font-black">
                1. Was habe ich in dieser Lektion gelernt?
            </h3>

            <textarea
                placeholder="Meine Antwort..."
            ></textarea>

        </div>



        <!-- FRAGE 2 -->

        <div class="question-card">

            <h3 class="text-xl font-black">
                2. Kann ich mich auf Deutsch vorstellen?
            </h3>

            <textarea
                placeholder="Meine Antwort..."
            ></textarea>

        </div>



        <!-- FRAGE 3 -->

        <div class="question-card">

            <h3 class="text-xl font-black">
                3. Kann ich jemanden formell begrüßen?
            </h3>

            <textarea
                placeholder="Meine Antwort..."
            ></textarea>

        </div>



        <!-- FRAGE 4 -->

        <div class="question-card">

            <h3 class="text-xl font-black">
                4. Kann ich jemanden informell begrüßen?
            </h3>

            <textarea
                placeholder="Meine Antwort..."
            ></textarea>

        </div>



        <!-- FRAGE 5 -->

        <div class="question-card">

            <h3 class="text-xl font-black">
                5. Kann ich sagen, woher ich komme?
            </h3>

            <textarea
                placeholder="Meine Antwort..."
            ></textarea>

        </div>



        <!-- FRAGE 6 -->

        <div class="question-card">

            <h3 class="text-xl font-black">
                6. Was kann ich schon gut?
            </h3>

            <textarea
                placeholder="Meine Antwort..."
            ></textarea>

        </div>



        <!-- FRAGE 7 -->

        <div class="question-card">

            <h3 class="text-xl font-black">
                7. Was muss ich noch üben?
            </h3>

            <textarea
                placeholder="Meine Antwort..."
            ></textarea>

        </div>



        <!-- BOUTON -->

        <div class="text-center mt-8">

            <button
                id="saveButton"
                type="button"
                class="
                    save-button
                    bg-black
                    text-white
                    px-8
                    py-4
                    rounded-2xl
                    font-black
                    shadow-xl
                "
            >
                💾 Antworten speichern
            </button>

            <div
                id="status"
                class="mt-4 font-bold opacity-70"
            ></div>

        </div>

    </section>



    <!-- RETOUR -->

    <section class="flex justify-center mt-12">

        <a
            href="lektion2.html"
            class="
                back-button
                bg-white
                px-8
                py-4
                rounded-2xl
                font-black
                shadow-xl
            "
        >
            ← Zurück zu Lektion 2
        </a>

    </section>


</main>



<script>

const textareas =
    document.querySelectorAll("textarea");

const saveButton =
    document.getElementById("saveButton");

const status =
    document.getElementById("status");


/* =========================
   SPEICHERN
========================= */

saveButton.addEventListener("click", () => {

    const answers = [];

    textareas.forEach(
        textarea => {
            answers.push(textarea.value);
        }
    );

    localStorage.setItem(
        "haryfi_lektion2_reflektion",
        JSON.stringify(answers)
    );

    status.textContent =
        "✅ Deine Antworten wurden gespeichert.";

});


/* =========================
   ANTWORTEN LADEN
========================= */

const saved =
    localStorage.getItem(
        "haryfi_lektion2_reflektion"
    );

if (saved) {

    const answers =
        JSON.parse(saved);

    textareas.forEach(
        (textarea, index) => {

            if (answers[index]) {
                textarea.value =
                    answers[index];
            }

        }
    );

}

</script>


</body>
</html>
