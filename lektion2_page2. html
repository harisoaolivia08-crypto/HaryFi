<!-- =====================================================
     JAVASCRIPT
===================================================== -->

<script>


/* =====================================================
   AUDIO BASE
===================================================== */

const AUDIO_BASE =
    "https://harisoaolivia08-crypto.github.io/HaryFi/Audio/";


/* =====================================================
   AUDIO FILES
===================================================== */

const audioFiles = {

    button1:
        AUDIO_BASE + "l2_page2_erklaerung.mp3",

    button2:
        AUDIO_BASE + "l2_page2_begruessung.mp3",

    button3:
        AUDIO_BASE + "l2_page2_verabschiedung.mp3",

    button4:
        AUDIO_BASE + "l2_page2_uebung.mp3"

};



/* =====================================================
   ELEMENTS
===================================================== */

const status =
    document.getElementById("status");


const buttons = {

    button1:
        document.getElementById("audioButton1"),

    button2:
        document.getElementById("audioButton2"),

    button3:
        document.getElementById("audioButton3"),

    button4:
        document.getElementById("audioButton4")

};



/* =====================================================
   AUDIO ACTUEL
===================================================== */

let currentAudio = null;



/* =====================================================
   ARRÊTER AUDIO
===================================================== */

function stopCurrentAudio() {

    if (currentAudio) {

        currentAudio.pause();

        currentAudio.currentTime = 0;

        currentAudio = null;

    }

}



/* =====================================================
   ENLEVER ANIMATION
===================================================== */

function removePlaying() {

    Object.values(buttons).forEach(
        button => {

            if (button) {

                button.classList.remove(
                    "playing"
                );

            }

        }
    );

}



/* =====================================================
   LIRE AUDIO
===================================================== */

function playAudio(
    url,
    message,
    button
) {

    stopCurrentAudio();

    removePlaying();


    if (!url) {

        status.textContent =
            "⚠️ Aucun audio configuré.";

        return;

    }


    const audio =
        new Audio(url);


    currentAudio =
        audio;


    button.classList.add(
        "playing"
    );


    status.textContent =
        "🔊 " + message;


    audio.addEventListener(
        "ended",
        () => {

            button.classList.remove(
                "playing"
            );

            currentAudio = null;

            status.textContent =
                "✅ Audio terminé.";

        },
        {
            once: true
        }
    );


    audio.addEventListener(
        "error",
        () => {

            button.classList.remove(
                "playing"
            );

            currentAudio = null;

            status.textContent =
                "⚠️ Audio pas encore disponible.";

            console.log(
                "Audio introuvable :",
                url
            );

        },
        {
            once: true
        }
    );


    audio.play()
        .catch(
            error => {

                button.classList.remove(
                    "playing"
                );

                currentAudio = null;

                console.log(
                    "Erreur audio :",
                    error
                );

                status.textContent =
                    "⚠️ Impossible de lire l'audio.";

            }
        );

}



/* =====================================================
   BOUTON 1
===================================================== */

buttons.button1.addEventListener(
    "click",
    () => {

        playAudio(
            audioFiles.button1,
            "Erklärung der Lektion",
            buttons.button1
        );

    }
);



/* =====================================================
   BOUTON 2
===================================================== */

buttons.button2.addEventListener(
    "click",
    () => {

        playAudio(
            audioFiles.button2,
            "Begrüßung",
            buttons.button2
        );

    }
);



/* =====================================================
   BOUTON 3
===================================================== */

buttons.button3.addEventListener(
    "click",
    () => {

        playAudio(
            audioFiles.button3,
            "Verabschiedung",
            buttons.button3
        );

    }
);



/* =====================================================
   BOUTON 4
===================================================== */

buttons.button4.addEventListener(
    "click",
    () => {

        playAudio(
            audioFiles.button4,
            "Übung",
            buttons.button4
        );

    }
);


</script>


