<!DOCTYPE html>
<html lang="de">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>HaryFi – Lektion 2: Kurzsätze zum Üben</title>

    <script src="https://cdn.tailwindcss.com"></script>

    <style>
        @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;800;900&display=swap');

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            min-height: 100vh;
            font-family: 'Plus Jakarta Sans', sans-serif;
            color: #17120d;

            background: linear-gradient(
                -45deg,
                #ff4500,
                #ff7e00,
                #ffd000,
                #00c9ff,
                #7c3aed,
                #ff3cac
            );

            background-size: 500% 500%;
            animation: gradientMove 18s ease infinite;
        }

        @keyframes gradientMove {
            0% {
                background-position: 0% 50%;
            }

            25% {
                background-position: 100% 50%;
            }

            50% {
                background-position: 100% 100%;
            }

            75% {
                background-position: 0% 100%;
            }

            100% {
                background-position: 0% 50%;
            }
        }

        .glass {
            background: rgba(255,255,255,.22);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid rgba(255,255,255,.45);
        }

        .main-button {
            transition:
                transform .2s ease,
                box-shadow .2s ease;
        }

        .main-button:hover {
            transform: scale(1.04);
            box-shadow: 0 20px 45px rgba(0,0,0,.25);
        }

        .main-button:active {
            transform: scale(.96);
        }

        .sentence-card {
            background: rgba(255,255,255,.92);
            transition:
                transform .25s ease,
                box-shadow .25s ease;
        }

        .sentence-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 20px 40px rgba(0,0,0,.18);
        }

        .sentence-card.playing {
            animation: pulseCard .55s ease;
        }

        @keyframes pulseCard {

            0% {
                transform: scale(1);
            }

            40% {
                transform: scale(1.04);
            }

            70% {
                transform: scale(.98);
            }

            100% {
                transform: scale(1);
            }

        }

        .audio-button {
            transition:
                transform .2s ease,
                box-shadow .2s ease;
        }

        .audio-button:hover {
            transform: scale(1.04);
        }

        .audio-button:active {
            transform: scale(.96);
        }

        .hidden-section {
            display: none;
        }

        .visible-section {
            display: block;
            animation: appear .7s ease;
        }

        @keyframes appear {

            from {
                opacity: 0;
                transform: translateY(25px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }

        }

        .status {
            min-height: 25px;
            margin-top: 15px;
            font-weight: 800;
            opacity: .8;
        }

        .vocab-item {
            background: rgba(255,255,255,.88);
            border-radius: 16px;
            padding: 16px 18px;
        }

        .vocab-german {
            font-size: 18px;
            font-weight: 900;
        }

        .vocab-french {
            margin-top: 5px;
            font-size: 15px;
            opacity: .75;
        }
    </style>
</head>


<body>


<header class="px-5 py-5">

    <div class="max-w-7xl mx-auto flex items-center justify-between gap-4">

        <a
            href="index.html"
            class="glass rounded-2xl px-5 py-3 font-black text-lg"
        >
            ← HaryFi
        </a>

        <div class="glass rounded-full px-5 py-2 font-bold text-sm">
            🇩🇪 Deutschkurs
        </div>

    </div>

</header>



<main class="max-w-6xl mx-auto px-5 pb-20">


    <!-- =================================================
         TITRE
    ================================================== -->

    <section class="text-center pt-8 pb-10">

        <div
            class="
                inline-block
                glass
                rounded-full
                px-5
                py-2
                mb-5
                text-xs
                font-black
                uppercase
                tracking-widest
            "
        >
            Lektion 2 · Seite 2
        </div>


        <h1 class="text-5xl md:text-7xl font-black tracking-tight mb-5">
            Kurzsätze zum Üben
        </h1>


        <p class="text-lg md:text-xl font-semibold max-w-3xl mx-auto">
            Übe kurze Sätze mit formellen und informellen Begrüßungen.
        </p>


        <!-- =================================================
             BOUTON 1 – ERKLÄRUNG
        ================================================== -->

        <button
            id="erklaerungButton"
            type="button"
            class="
                main-button
                mt-8
                bg-black
                text-white
                px-9
                py-5
                rounded-3xl
                font-black
                text-xl
                shadow-2xl
            "
        >
            ▶️ Erklärung
        </button>


        <div id="status" class="status">
            Wähle eine Erklärung.
        </div>

    </section>



    <!-- =================================================
         BOUTON 2 – FORMELL
    ================================================== -->

    <section class="mb-10">

        <div class="glass rounded-[32px] p-6 md:p-10">

            <div class="text-center">

                <div class="text-5xl mb-4">
                    🤝
                </div>


                <h2 class="text-4xl md:text-5xl font-black">
                    Formell
                </h2>


                <button
                    id="formellButton"
                    type="button"
                    class="
                        audio-button
                        mt-5
                        bg-black
                        text-white
                        px-8
                        py-4
                        rounded-2xl
                        font-black
                        shadow-xl
                    "
                >
                    ▶️ Formell
                </button>

            </div>


            <div
                id="formellSection"
                class="hidden-section mt-8"
            >

                <div
                    id="formellSentences"
                    class="grid gap-5"
                ></div>

            </div>

        </div>

    </section>



    <!-- =================================================
         BOUTON 3 – INFORMELL
    ================================================== -->

    <section class="mb-10">

        <div class="glass rounded-[32px] p-6 md:p-10">

            <div class="text-center">

                <div class="text-5xl mb-4">
                    👋
                </div>


                <h2 class="text-4xl md:text-5xl font-black">
                    Informell
                </h2>


                <button
                    id="informellButton"
                    type="button"
                    class="
                        audio-button
                        mt-5
                        bg-black
                        text-white
                        px-8
                        py-4
                        rounded-2xl
                        font-black
                        shadow-xl
                    "
                >
                    ▶️ Informell
                </button>

            </div>


            <div
                id="informellSection"
                class="hidden-section mt-8"
            >

                <div
                    id="informellSentences"
                    class="grid gap-5"
                ></div>

            </div>

        </div>

    </section>



    <!-- =================================================
         BOUTON 4 – VOKABULAR
    ================================================== -->

    <section>

        <div class="glass rounded-[32px] p-6 md:p-10">

            <div class="text-center">

                <div class="text-5xl mb-4">
                    📚
                </div>


                <h2 class="text-4xl md:text-5xl font-black">
                    Vokabular
                </h2>


                <button
                    id="vocabularButton"
                    type="button"
                    class="
                        audio-button
                        mt-5
                        bg-black
                        text-white
                        px-8
                        py-4
                        rounded-2xl
                        font-black
                        shadow-xl
                    "
                >
                    ▶️ Vokabular anhören
                </button>

            </div>


            <div
                id="vocabularSection"
                class="hidden-section mt-8"
            >

                <div
                    id="vocabularList"
                    class="grid gap-3"
                ></div>

            </div>

        </div>

    </section>



    <!-- =================================================
         RETOUR
    ================================================== -->

    <section class="flex justify-center mt-14">

        <a
            href="lektion2.html"
            class="
                bg-black
                text-white
                px-8
                py-4
                rounded-2xl
                font-black
                shadow-xl
            "
        >
            ← Lektion 2
        </a>

    </section>

</main>



<script>

/* =====================================================
   AUDIO BASE
===================================================== */

const AUDIO_BASE =
    "https://harisoaolivia08-crypto.github.io/HaryFi/Audio/";


/* =====================================================
   AUDIO EXPLICATION
===================================================== */

const audioFiles = {

    erklaerung:
        AUDIO_BASE + "l2_page2_erklaerung.mp3",

    formell:
        AUDIO_BASE + "l2_page2_formell.mp3",

    informell:
        AUDIO_BASE + "l2_page2_informell.mp3",

    vocabular:
        AUDIO_BASE + "l2_page2_vocabular.mp3"

};


/* =====================================================
   PHRASES FORMELL
===================================================== */

const formellSentences = [

    {
        text:
            "Guten Morgen, ich heiße Hary.",

        audio:
            AUDIO_BASE +
            "l2_page2_formell_01.mp3"
    },


    {
        text:
            "Guten Tag, mein Name ist Fitiavana. Ich komme aus Madagaskar.",

        audio:
            AUDIO_BASE +
            "l2_page2_formell_02.mp3"
    },


    {
        text:
            "Guten Abend, ich heiße Ndimby. Ich komme aus Madagaskar, aus Fianarantsoa.",

        audio:
            AUDIO_BASE +
            "l2_page2_formell_03.mp3"
    }

];


/* =====================================================
   PHRASES INFORMELL
===================================================== */

const informellSentences = [

    {
        text:
            "Servus, ich bin Anna. Ich komme aus Deutschland, aus Berlin.",

        audio:
            AUDIO_BASE +
            "l2_page2_informell_01.mp3"
    },


    {
        text:
            "Moin, ich bin Max. Ich komme aus Deutschland, aus Berlin.",

        audio:
            AUDIO_BASE +
            "l2_page2_informell_02.mp3"
    },


    {
        text:
            "Hallo, ich bin Marie. Ich komme aus Deutschland, aus Berlin. Wie geht es dir?",

        audio:
            AUDIO_BASE +
            "l2_page2_informell_03.mp3"
    },


    {
        text:
            "Ich bin Olivia. Ich komme aus Madagaskar, aus Fandriana. Mir geht es gut. Und dir?",

        audio:
            AUDIO_BASE +
            "l2_page2_informell_04.mp3"
    }

];


/* =====================================================
   VOKABULAR
===================================================== */

const vocabular = [

    {
        german:
            "Ich heiße …",

        french:
            "Je m'appelle …"
    },


    {
        german:
            "Ich komme aus …",

        french:
            "Je viens de …"
    },


    {
        german:
            "Wie geht es Ihnen?",

        french:
            "Comment allez-vous ?"
    },


    {
        german:
            "Wie geht es dir?",

        french:
            "Comment ça va ?"
    },


    {
        german:
            "Mir geht es gut.",

        french:
            "Je vais bien."
    },


    {
        german:
            "Und dir?",

        french:
            "Ary ianao ? / Et toi ?"
    },


    {
        german:
            "Ich auch.",

        french:
            "Moi aussi. / Izaho ihany koa."
    },


    {
        german:
            "Ich bin …",

        french:
            "Je suis … / Izaho dia …"
    }

];


/* =====================================================
   ELEMENTS
===================================================== */

const erklaerungButton =
    document.getElementById(
        "erklaerungButton"
    );


const formellButton =
    document.getElementById(
        "formellButton"
    );


const informellButton =
    document.getElementById(
        "informellButton"
    );


const vocabularButton =
    document.getElementById(
        "vocabularButton"
    );


const formellSection =
    document.getElementById(
        "formellSection"
    );


const informellSection =
    document.getElementById(
        "informellSection"
    );


const vocabularSection =
    document.getElementById(
        "vocabularSection"
    );


const formellContainer =
    document.getElementById(
        "formellSentences"
    );


const informellContainer =
    document.getElementById(
        "informellSentences"
    );


const vocabularContainer =
    document.getElementById(
        "vocabularList"
    );


const status =
    document.getElementById(
        "status"
    );


let currentAudio = null;


/* =====================================================
   AUDIO
===================================================== */

function playAudio(url, description) {

    if (!url) {
        return;
    }


    if (currentAudio) {

        currentAudio.pause();

        currentAudio.currentTime = 0;

    }


    const audio =
        new Audio(url);


    currentAudio =
        audio;


    status.textContent =
        "🔊 " + description;


    audio.addEventListener(
        "ended",
        () => {

            currentAudio = null;

        },
        {
            once: true
        }
    );


    audio.addEventListener(
        "error",
        () => {

            status.textContent =
                "⚠️ Audiodatei noch nicht vorhanden.";

            console.log(
                "Audio nicht gefunden:",
                url
            );

            currentAudio = null;

        },
        {
            once: true
        }
    );


    audio.play()
        .catch(error => {

            console.log(
                "Audio konnte nicht abgespielt werden:",
                error
            );

        });

}


/* =====================================================
   PHRASE CARD
===================================================== */

function createSentenceCard(
    sentence,
    index
) {

    const card =
        document.createElement(
            "div"
        );


    card.className =
        "sentence-card rounded-3xl p-6 shadow-xl";


    card.innerHTML = `

        <div class="
            text-xl
            md:text-2xl
            font-black
            leading-relaxed
        ">
            ${sentence.text}
        </div>

        <button
            type="button"
            class="
                audio-button
                mt-5
                bg-black
                text-white
                px-6
                py-3
                rounded-2xl
                font-black
            "
        >
            🔊 Anhören
        </button>

    `;


    const button =
        card.querySelector(
            "button"
        );


    button.addEventListener(
        "click",
        () => {

            card.classList.remove(
                "playing"
            );

            void card.offsetWidth;

            card.classList.add(
                "playing"
            );


            playAudio(
                sentence.audio,
                sentence.text
            );

        }
    );


    return card;

}


/* =====================================================
   FORMELL ERSTELLEN
===================================================== */

formellSentences.forEach(
    (sentence, index) => {

        formellContainer.appendChild(
            createSentenceCard(
                sentence,
                index
            )
        );

    }
);


/* =====================================================
   INFORMELL ERSTELLEN
===================================================== */

informellSentences.forEach(
    (sentence, index) => {

        informellContainer.appendChild(
            createSentenceCard(
                sentence,
                index
            )
        );

    }
);


/* =====================================================
   VOKABULAR ERSTELLEN
===================================================== */

vocabular.forEach(
    item => {

        const element =
            document.createElement(
                "div"
            );


        element.className =
            "vocab-item";


        element.innerHTML = `

            <div class="vocab-german">
                ${item.german}
            </div>

            <div class="vocab-french">
                ${item.french}
            </div>

        `;


        vocabularContainer.appendChild(
            element
        );

    }
);


/* =====================================================
   BOUTON 1 – ERKLÄRUNG
===================================================== */

erklaerungButton.addEventListener(
    "click",
    () => {

        playAudio(
            audioFiles.erklaerung,
            "Erklärung"
        );

    }
);


/* =====================================================
   BOUTON 2 – FORMELL
===================================================== */

formellButton.addEventListener(
    "click",
    () => {

        formellSection.classList.remove(
            "hidden-section"
        );

        formellSection.classList.add(
            "visible-section"
        );


        playAudio(
            audioFiles.formell,
            "Erklärung: Formell"
        );

    }
);


/* =====================================================
   BOUTON 3 – INFORMELL
===================================================== */

informellButton.addEventListener(
    "click",
    () => {

        informellSection.classList.remove(
            "hidden-section"
        );

        informellSection.classList.add(
            "visible-section"
        );


        playAudio(
            audioFiles.informell,
            "Erklärung: Informell"
        );

    }
);


/* =====================================================
   BOUTON 4 – VOKABULAR
===================================================== */

vocabularButton.addEventListener(
    "click",
    () => {

        vocabularSection.classList.remove(
            "hidden-section"
        );

        vocabularSection.classList.add(
            "visible-section"
        );


        playAudio(
            audioFiles.vocabular,
            "Vokabular"
        );

    }
);

</script>


</body>
</html>
